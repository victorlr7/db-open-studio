# DBOpenStudio environment template
#
# Copy this file to `.env.local` for local development.
# Never commit `.env.local` or any file containing real secrets.

# -----------------------------------------------------------------------------
# Optional DBOpenStudio app persistence
# -----------------------------------------------------------------------------
# Supported app persistence modes today:
#
# 1. Local JSON fallback:
#    Leave NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and
#    DBOPENSTUDIO_DATABASE_URL empty. DBOpenStudio stores its workspace in
#    data/dbopenstudio.json and uses the local user selector.
#
# 2. Supabase Auth + Supabase Postgres:
#    Set all three variables below. DBOpenStudio uses Supabase Auth for login and
#    stores users/projects/snapshots/models/migrations in Supabase Postgres.
#    Run `npm run db:setup` once to apply supabase/schema.sql.
#
# Standalone Postgres app persistence is NOT supported yet. A plain Postgres URL
# here will not work because DBOpenStudio's remote app schema depends on
# Supabase Auth objects such as auth.users and auth.uid().
#
# DBOPENSTUDIO_DATABASE_URL must point to the Supabase Postgres database that has
# the Supabase auth schema. If you do not want Supabase Auth, leave these empty
# and use local JSON.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DBOPENSTUDIO_DATABASE_URL=

# Optional local JSON store override. Useful for isolated tests or demos.
# Leave empty to use data/dbopenstudio.json.
DBOPENSTUDIO_LOCAL_STORE_PATH=

# -----------------------------------------------------------------------------
# Optional AI assistant
# -----------------------------------------------------------------------------
# The public flag controls the AI UI and the AI API routes. The OpenAI token is
# server-only and must never be prefixed with NEXT_PUBLIC_.

NEXT_PUBLIC_DBOPENSTUDIO_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PLANNER_MODEL=gpt-5-mini

# Example DBOPENSTUDIO_DATABASE_URL formats:
# Local Supabase CLI:
# DBOPENSTUDIO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Direct Supabase database:
# DBOPENSTUDIO_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Supabase transaction pooler:
# DBOPENSTUDIO_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Supabase normally uses the physical database name "postgres" in connection
# strings. Name the Supabase project "dbopenstudio" if you want the hosted
# project itself to carry the product name.
#
# Local Postgres for source schema import does not require env vars. Add that
# connection from the Import modal in the UI.
